# Hackathon API Token
API_KEY=your_hackathon_api_key_here

DEFAULT_DATA_PROVIDER=yfinance
FALLBACK_TO_YFINANCE=true
HACKATHON_API_BASE_URL=

# Featherless AI Research Assistant
FEATHERLESS_API_KEY=
FEATHERLESS_API_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=unsloth/Llama-3.3-70B-Instruct

DATABASE_URL=sqlite:///data/market_cache.db
CACHE_TTL_HOURS=24

HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
